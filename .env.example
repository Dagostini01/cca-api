# Copie para .env e troque as senhas locais.
# Valores para o host (npm run dev).
# O serviço api no Compose sobrescreve NODE_ENV, HOST, KEYCLOAK_JWKS_URI, MYSQL_HOST, MYSQL_PORT e DATABASE_URL.
# Se a porta 3306 do host já estiver em uso, use 3307 em MYSQL_PORT, MYSQL_PUBLISH_PORT e na DATABASE_URL.

NODE_ENV=development
PORT=3000
HOST=127.0.0.1
KEYCLOAK_ISSUER=http://localhost:8080/realms/cca
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/cca/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=cca-api
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_PUBLISH_PORT=3306
MYSQL_DATABASE=cca
MYSQL_USER=cca
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-root-local
DATABASE_URL=mysql://cca:change-me-local@127.0.0.1:3306/cca
KC_DB_PASSWORD=change-keycloak-db-local
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-keycloak-admin-local
CCA_DEV_USER=dev.user
CCA_DEV_USER_PASSWORD=change-dev-user-local
